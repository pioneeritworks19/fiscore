rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function tenantMemberPath(tenantId) {
      return /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function isActiveTenantMember(tenantId) {
      return signedIn() &&
        firestore.exists(tenantMemberPath(tenantId)) &&
        firestore.get(tenantMemberPath(tenantId)).data.status == 'active';
    }

    function hasAllSiteAccess(tenantId) {
      return isActiveTenantMember(tenantId) &&
        (
          firestore.get(tenantMemberPath(tenantId)).data.role in ['tenant_owner', 'admin'] ||
          firestore.get(tenantMemberPath(tenantId)).data.siteAccessMode == 'all'
        );
    }

    function hasSiteAccess(tenantId, siteId) {
      return hasAllSiteAccess(tenantId) ||
        (
          isActiveTenantMember(tenantId) &&
          firestore.get(tenantMemberPath(tenantId)).data.siteIds is list &&
          firestore.get(tenantMemberPath(tenantId)).data.siteIds.hasAny([siteId])
        );
    }

    match /fiscoreLibrary/training/{trainingId}/versions/{version}/media/{mediaId}/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /tenants/{tenantId}/sites/{siteId}/violations/{violationId}/attachments/{attachmentId}/{fileName} {
      allow read: if hasSiteAccess(tenantId, siteId);
      allow create: if hasSiteAccess(tenantId, siteId) &&
        (
          (
            request.resource.contentType.matches('image/.*') &&
            request.resource.size < 10 * 1024 * 1024
          ) ||
          (
            request.resource.contentType.matches('video/.*') &&
            request.resource.size < 25 * 1024 * 1024
          )
        );
      allow delete: if hasSiteAccess(tenantId, siteId);
      allow update: if false;
    }

    match /tenants/{tenantId}/sites/{siteId}/inspections/{inspectionId}/attachments/{attachmentId}/{fileName} {
      allow read: if hasSiteAccess(tenantId, siteId);
      allow create: if hasSiteAccess(tenantId, siteId) &&
        (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'text/html' ||
          request.resource.contentType.matches('image/.*')
        ) &&
        request.resource.size < 15 * 1024 * 1024;
      allow delete: if hasSiteAccess(tenantId, siteId);
      allow update: if false;
    }

    match /tenants/{tenantId}/sites/{siteId}/audits/{auditId}/attachments/{attachmentId}/{fileName} {
      allow read: if hasSiteAccess(tenantId, siteId);
      allow create: if hasSiteAccess(tenantId, siteId) &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < 10 * 1024 * 1024;
      allow delete: if hasSiteAccess(tenantId, siteId);
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
