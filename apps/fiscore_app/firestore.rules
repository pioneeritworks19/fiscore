rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberDoc(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    function isActiveTenantMember(tenantId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) &&
        memberDoc(tenantId).data.status == 'active';
    }

    function hasAllSiteAccess(tenantId) {
      return isActiveTenantMember(tenantId) &&
        (
          memberDoc(tenantId).data.role in ['tenant_owner', 'admin'] ||
          memberDoc(tenantId).data.siteAccessMode == 'all'
        );
    }

    function hasSiteAccess(tenantId, siteId) {
      return hasAllSiteAccess(tenantId) ||
        (
          isActiveTenantMember(tenantId) &&
          memberDoc(tenantId).data.siteIds is list &&
          memberDoc(tenantId).data.siteIds.hasAny([siteId])
        );
    }

    function isTenantAdmin(tenantId) {
      return isActiveTenantMember(tenantId) &&
        memberDoc(tenantId).data.role in ['tenant_owner', 'admin'];
    }

    function canAssignTraining(tenantId) {
      return isActiveTenantMember(tenantId) &&
        memberDoc(tenantId).data.role in ['tenant_owner', 'admin', 'manager'];
    }

    function canEditViolationResolution(tenantId, assignedTo) {
      return assignedTo == null ||
        assignedTo == '' ||
        assignedTo == request.auth.uid ||
        (
          isActiveTenantMember(tenantId) &&
          memberDoc(tenantId).data.role in ['tenant_owner', 'admin', 'manager']
        );
    }

    function assignedMemberHasSiteAccess(tenantId, siteId, userId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(userId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(userId)).data.status == 'active' &&
        (
          get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(userId)).data.role in ['tenant_owner', 'admin'] ||
          get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(userId)).data.siteAccessMode != 'selected' ||
          (
            get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(userId)).data.siteIds is list &&
            get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(userId)).data.siteIds.hasAny([siteId])
          )
        );
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow read, update: if isSelf(userId);
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if isActiveTenantMember(tenantId);
      allow create, update, delete: if false;

      match /members/{userId} {
        allow read: if isActiveTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      match /invites/{inviteId} {
        allow read: if isActiveTenantMember(tenantId) ||
          (signedIn() &&
            resource.data.status == 'pending' &&
            resource.data.email == request.auth.token.email.lower());
        allow create, update, delete: if false;
      }

      match /teamActivity/{activityId} {
        allow read: if isTenantAdmin(tenantId);
        allow create, update, delete: if false;
      }

      match /actionItems/{actionItemId} {
        allow read: if isActiveTenantMember(tenantId) &&
          (
            resource.data.recipientUserId == request.auth.uid ||
            (
              resource.data.managerVisible == true &&
              canAssignTraining(tenantId) &&
              hasSiteAccess(tenantId, resource.data.siteId)
            )
          );
        allow update: if isActiveTenantMember(tenantId) &&
          resource.data.recipientUserId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readAt',
            'updatedAt'
          ]);
        allow create, delete: if false;
      }

      match /trainings/{trainingId} {
        allow read: if isActiveTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      match /checklistTemplates/{templateId} {
        allow read: if isActiveTenantMember(tenantId);
        allow create, update, delete: if false;
      }

      match /trainingAssignments/{assignmentId} {
        allow read: if isActiveTenantMember(tenantId) &&
          (
            resource.data.assignedTo == request.auth.uid ||
            (
              canAssignTraining(tenantId) &&
              hasSiteAccess(tenantId, resource.data.siteId)
            )
          );
        allow create: if false;
        allow update: if
          (
            isActiveTenantMember(tenantId) &&
            resource.data.assignedTo == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'progressPercent',
              'startedAt',
              'updatedAt'
            ]) &&
            request.resource.data.status == 'in_progress'
          );
        allow delete: if false;
      }

      match /sites/{siteId} {
        allow read: if hasSiteAccess(tenantId, siteId);
        allow create, update, delete: if false;

        match /inspections/{inspectionId} {
          allow read, update: if hasSiteAccess(tenantId, siteId);
          allow create, delete: if false;

          match /attachments/{attachmentId} {
            allow read, create, update: if hasSiteAccess(tenantId, siteId);
            allow delete: if false;
          }
        }

        match /audits/{auditId} {
          allow read: if hasSiteAccess(tenantId, siteId);
          allow create, update, delete: if false;

          match /responses/{responseId} {
            allow read, create, update: if hasSiteAccess(tenantId, siteId);
            allow delete: if false;
          }

          match /attachments/{attachmentId} {
            allow read, create, update: if hasSiteAccess(tenantId, siteId);
            allow delete: if false;
          }
        }

        match /auditAssignments/{assignmentId} {
          allow read: if hasSiteAccess(tenantId, siteId) &&
            (
              resource.data.assignedTo == request.auth.uid ||
              canAssignTraining(tenantId)
            );
          allow create, update, delete: if false;
        }

        match /violations/{violationId} {
          allow read: if hasSiteAccess(tenantId, siteId);
          allow create, delete: if false;
          allow update: if hasSiteAccess(tenantId, siteId) &&
            (
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'latestThreadEntrySummary',
                  'latestThreadEntryAt',
                  'syncStatus',
                  'updatedAt'
                ])
              ) ||
              (
                canEditViolationResolution(tenantId, resource.data.get('assignedTo', null)) &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'responseGeneral',
                'responseContainment',
                'responseRootCause',
                'responseCorrectiveAction',
                'responsePreventiveAction',
                'currentResponseType',
                'syncStatus',
                'updatedAt'
                ])
              ) ||
              (
                canEditViolationResolution(tenantId, resource.data.get('assignedTo', null)) &&
                resource.data.status == 'open' &&
                request.resource.data.status == 'in_progress' &&
                request.resource.data.lifecycleStage == 'in_progress' &&
                request.resource.data.reviewStatus == 'not_submitted' &&
                request.resource.data.requiresReview == false &&
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'responseGeneral',
                  'responseContainment',
                  'responseRootCause',
                  'responseCorrectiveAction',
                  'responsePreventiveAction',
                  'currentResponseType',
                  'syncStatus',
                  'status',
                  'lifecycleStage',
                  'reviewStatus',
                  'requiresReview',
                  'updatedAt'
                ])
              )
            );

          match /responses/{responseId} {
            allow read: if hasSiteAccess(tenantId, siteId);
            allow create, update: if hasSiteAccess(tenantId, siteId) &&
              canEditViolationResolution(
                tenantId,
                get(/databases/$(database)/documents/tenants/$(tenantId)/sites/$(siteId)/violations/$(violationId)).data.get('assignedTo', null)
              );
            allow delete: if false;
          }

          match /threads/{threadId} {
            allow read, create, update, delete: if hasSiteAccess(tenantId, siteId);
          }

          match /attachments/{attachmentId} {
            allow read, create, update, delete: if hasSiteAccess(tenantId, siteId);
          }
        }
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
